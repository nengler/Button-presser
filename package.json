{
  "name": "button-presser",
  "version": "0.1.0",
  "private": true,
  "description": "A timing game — press every second. Closer means more points.",
  "type": "module",
  "main": "dist-electron/electron-main.js",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.electron.json && vite build",
    "watch": "vite",
    "electron": "npm run build && electron .",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "knip": "knip"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "knip": "^6.32.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
